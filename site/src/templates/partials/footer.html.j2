{%- from "partials/macros.html.j2" import icon, grill_divider with context -%}
{{ grill_divider() }}
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="{{ page_href.home }}"><img src="{{ files.logo.src }}" alt="{{ b.name }}, home" width="{{ files.logo.width }}" height="{{ files.logo.height }}" loading="lazy" decoding="async"></a>
        <p class="tagline">Jamaican food in Malton, Mississauga.</p>
        <p class="rating-line"><span aria-hidden="true">★</span> {{ b.rating }} on Google from {{ b.review_count }} reviews</p>
      </div>
      <div>
        <h2>Visit</h2>
        <ul>
          <li><a href="tel:{{ b.phone_e164 }}">{{ b.phone_display }}</a></li>
          <li>{{ b.address.street }}<br>{{ b.address.city }}, {{ b.address.region }} {{ b.address.postal_code }}</li>
          <li><a href="{{ directions_url }}" target="_blank" rel="noopener">Get directions<span class="visually-hidden"> (opens Google Maps in a new tab)</span></a></li>
          <li>Hours: {{ c.hours_note | ph }}</li>
        </ul>
      </div>
      <div>
        <h2>Pages</h2>
        <ul class="footer-nav">
          {%- for p in nav %}<li><a href="{{ p.file }}"{% if p.id == page.id %} aria-current="page"{% endif %}>{{ p.nav_label }}</a></li>{%- endfor %}
        </ul>
      </div>
    </div>
    <aside class="demo-features" aria-label="Business package features shown on this demo">
      <p><strong>Demo only · Business package features on this site:</strong>{%- for f in c.package.features %} <span>{{ f.n }}. {{ f.text }}{% if not loop.last %};{% else %}.{% endif %}</span>{% endfor %}</p>
    </aside>
    <div class="footer-bottom"><p class="footer-legal">{{ c.meta.copyright_line }}</p></div>
  </div>
</footer>
<nav class="mobile-callbar" aria-label="Call, directions and order">
  <a class="btn btn--primary" href="tel:{{ b.phone_e164 }}" aria-label="Call {{ b.phone_display }}">{{ icon("phone") }}Call</a>
  <a class="btn btn--gold" href="{{ directions_url }}" target="_blank" rel="noopener" aria-label="Directions (opens Google Maps in a new tab)">{{ icon("pin") }}Directions</a>
  <a class="btn btn--ghost" href="{{ page_href.menu }}">{{ icon("menu") }}Menu</a>
</nav>
