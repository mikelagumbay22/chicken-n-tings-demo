{% extends "base.html.j2" %}
{% from "partials/macros.html.j2" import icon, media, contact_buttons, disabled_note, inquiry_form with context %}
{% block content %}
<section class="page-hero" aria-labelledby="page-title">
  <div class="container section-head">
    <p class="eyebrow">Order & catering · Mississauga</p>
    <h1 id="page-title">Pickup orders and Jamaican catering</h1>
    <p class="lead">Call ahead for pickup at Brandon Gate Dr, or ask about catering for your party, office or event in Malton and around Mississauga.</p>
    {{ contact_buttons() }}
  </div>
</section>
<section class="section section--tight" aria-labelledby="cat-title">
  <div class="container split">
    <div class="reveal reveal-l"><div class="photo-frame">{{ media(c.images.catering, "(min-width: 900px) 520px, 92vw", "media--wide") }}</div></div>
    <div class="reveal reveal-r">
      <h2 id="cat-title">Catering</h2>
      <p>Trays of Jamaican favourites for a crowd. Tell us the date, how many people and what you'd like, and we'll get back to you.</p>
      <p class="note">{{ c.catering_note | ph }}</p>
    </div>
  </div>
</section>
<section class="section section--panel" id="inquiry" aria-labelledby="order-title">
  <div class="container quote-grid">
    <div class="reveal reveal-l">
      <h2 id="order-title">Send an order or catering inquiry</h2>
      {{ disabled_note("order-note") }}
    </div>
    {{ inquiry_form() }}
  </div>
</section>
{% endblock %}
